# Starts the orrery's touchscreen server at boot. Installed by install-kiosk.sh.
# Stop it before using servo_tool.py / orrery.py:  sudo systemctl stop orrery
[Unit]
Description=Orrery touchscreen server (servos + screen)
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/orrery
ExecStart=/usr/bin/python3 -u /home/pi/orrery/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
